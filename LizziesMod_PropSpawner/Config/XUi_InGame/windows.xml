<config>
    <setattribute xpath="/windows/window[@name='windowPagingHeader']" name="pos">-325,-9</setattribute>
    <setattribute xpath="/windows/window[@name='windowPagingHeader']" name="size">650,43</setattribute>
    <setattribute xpath="/windows/window[@name='windowPagingHeader']/sprite[@style='paging.window.background']" name="size">644,37</setattribute>
    <setattribute xpath="/windows/window[@name='windowPagingHeader']/sprite[@style='paging.window.name.background']" name="pos">325,-21</setattribute>
    <setattribute xpath="/windows/window[@name='windowPagingHeader']/sprite[@style='paging.window.name.foreground']" name="pos">325,-21</setattribute>
    <setattribute xpath="/windows/window[@name='windowPagingHeader']/label[@style='paging.window.name']" name="pos">325,-23</setattribute>
    <setattribute xpath="/windows/window[@name='windowPagingHeader']/gamepad_icon[@name='RB_Icon']" name="pos">658,-20</setattribute>
    <append xpath="/windows/window[@name='windowPagingHeader']">
        <iconbutton pos="626,-21" depth="3" selectable="true" collider_scale="1.5" name="windowPropSpawner" sprite="ui_game_symbol_resource" tooltip_key="xuiLizziesPropSpawner" snap="false" gamepad_selectable="false" visible="{is_creative}" />
    </append>

    <append xpath="/windows">
        <window name="windowPropSpawner" width="1280" height="760" anchor="Center" cursor_area="true" lock_navigation="true" controller="LizziesMod.PropSpawnerUIController, LizziesMod">
            <fullscreencollider color="0,0,0,220" />
            <rect depth="0" pos="-640,380" width="1280" height="760">
                <sprite depth="1" name="background" sprite="menu_empty" type="sliced" color="24,27,31,250" />
                <sprite depth="2" name="border" sprite="menu_empty2px" type="sliced" color="70,205,225,255" fillcenter="false" />

                <rect depth="3" pos="0,0" height="54">
                    <sprite depth="1" sprite="menu_empty" type="sliced" color="10,12,15,255" />
                    <label depth="2" pos="24,-11" width="800" height="32" text="PROP SPAWNER" font_size="30" color="70,205,225,255" font_weight="bold" />
                    <label name="lblStatus" depth="2" pos="1030,-14" width="220" height="28" text="0 PROPS" font_size="20" justify="right" color="180,190,195,255" />
                </rect>

                <rect name="categoryPane" depth="3" pos="20,-75" width="235" height="610">
                    <sprite depth="1" sprite="menu_empty" type="sliced" color="14,16,19,255" />
                    <sprite depth="2" sprite="menu_empty2px" type="sliced" color="52,62,70,255" fillcenter="false" />
                    <label depth="3" pos="14,-12" width="205" height="26" text="CATEGORIES" font_size="20" color="140,165,175,255" />

                    <rect depth="3" pos="8,-46" width="219" height="552" on_scroll="true">
                        <defaultscrollbar />
                        <scrollview width="196" clippingsoftness="0,10">
                            <grid name="categoryGrid" pos="0,0" rows="20" cols="1" cell_width="196" cell_height="44" arrangement="vertical" repeat_content="true">
                                <rect name="categoryEntry" controller="LizziesMod.PropSpawnCategoryEntryController, LizziesMod" width="196" height="40">
                                    <button name="clickable" depth="1" pos="0,0" width="196" height="40" sprite="menu_empty" type="sliced" defaultcolor="34,42,48,255" hovercolor="53,112,126,255" sound_play_on_hover="[default_hover]" sound="[default_click]" />
                                    <sprite name="sprSelected" depth="2" pos="0,0" width="4" height="40" sprite="menu_empty" type="sliced" color="70,205,225,255" visible="false" />
                                    <label name="lblCategoryName" depth="3" pos="12,-9" width="172" height="24" text="CATEGORY" font_size="18" color="[white]" />
                                </rect>
                            </grid>
                        </scrollview>
                    </rect>
                </rect>

                <rect name="contentPane" depth="3" pos="275,-75" width="985" height="610">
                    <sprite depth="1" sprite="menu_empty" type="sliced" color="14,16,19,255" />
                    <sprite depth="2" sprite="menu_empty2px" type="sliced" color="52,62,70,255" fillcenter="false" />

                    <textfield name="txtSearch" depth="3" pos="15,-13" width="955" height="38" font_size="20" justify="left" backgroundcolor="25,31,36,255" textcolor="255,255,255,255" active_text_color="70,205,225,255" caret_color="255,255,255,255" max_length="60" vk_propagates_events="false" />

                    <rect depth="3" pos="15,-64" width="955" height="522" on_scroll="true">
                        <defaultscrollbar />
                        <scrollview width="920" clippingsoftness="0,10">
                            <grid name="propGrid" pos="0,0" rows="5" cols="10" cell_width="92" cell_height="92" arrangement="horizontal" repeat_content="true">
                                <rect name="propEntry" controller="LizziesMod.PropSpawnEntryController, LizziesMod" width="88" height="88">
                                    <button name="clickable" depth="1" pos="2,-2" width="84" height="84" sprite="menu_empty" type="sliced" defaultcolor="34,42,48,255" hovercolor="48,106,119,255" sound_play_on_hover="[default_hover]" sound="[default_click]" />
                                    <item_stack name="propIcon" depth="2" pos="12,-12" width="64" height="64" />
                                </rect>
                            </grid>
                        </scrollview>
                    </rect>
                </rect>

                <rect depth="3" pos="20,-705" width="1240" height="42">
                    <simplebutton name="btnUndo" depth="1" pos="0,0" width="220" height="40" font_size="20" caption="UNDO LAST PROP" />
                    <simplebutton name="btnClearOwned" depth="1" pos="235,0" width="240" height="40" font_size="20" caption="REMOVE MY PROPS" />
                    <label depth="2" pos="500,-8" width="430" height="25" text="SELECT A PROP TO SPAWN IT" font_size="16" justify="center" color="155,170,175,255" />
                    <simplebutton name="btnClose" depth="1" pos="1000,0" width="240" height="40" font_size="20" caption="CLOSE" />
                </rect>
            </rect>
        </window>
    </append>
</config>