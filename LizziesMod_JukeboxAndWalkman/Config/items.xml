<configs>
    <append xpath="/items">
        <item name="itemWalkman">
            <property name="Extends" value="resourcePaper" />
            <property name="CustomIconTint" value="255,180,0" />
            <property name="Stacknumber" value="1" />
        </item>

        <item name="manualJukebox">
            <property name="Extends" value="resourcePaper" />
            <property name="CustomIconTint" value="255,180,0" />
            <property name="Stacknumber" value="1" />
            <property name="CustomIcon" value="manual" />
            <property class="Action1">
                <property name="Class" value="LizziesMod.ItemActionOpenModManual, LizziesMod" />
                <property name="BookId" value="guide_jukebox" />
            </property>
        </item>

        <item name="cassette_ExplanationOfAnEntity">
            <property name="Extends" value="resourcePaper" />
            <property name="CustomIcon" value="track" />
            <property name="CustomIconTint" value="80,180,255" />
            <property name="Stacknumber" value="1" />
            <property class="Action1">
                <property name="Class" value="LizziesMod.ItemActionPlayCassette, LizziesMod" />
            </property>
            <property name="MediaType" value="cassette" />
            <property name="TrackName" value="LizziesMod_JukeboxAndWalkman:explanation-of-an-entity" />
        </item>

        <!-- Custom Tracks -->

        <item name="musicDisc_ExplanationOfAnEntity">
            <property name="Extends" value="resourcePaper" />
            <property name="CustomIcon" value="itemTrack" />
            <property name="CustomIconTint" value="0,255,0" />
            <property name="Stacknumber" value="1" />
            <property class="Action1">
                <property name="Class" value="LizziesMod.ItemActionInsertMusicDisc, LizziesMod" />
            </property>
            <property name="MediaType" value="disc" />
            <property name="TrackName" value="LizziesMod_JukeboxAndWalkman:explanation-of-an-entity" />
        </item>
    </append>
</configs>